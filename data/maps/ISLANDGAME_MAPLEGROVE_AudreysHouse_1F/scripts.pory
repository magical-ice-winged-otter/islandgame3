mapscripts ISLANDGAME_MAPLEGROVE_AudreysHouse_1F_MapScripts {
}

// NPCs
script ISLANDGAME_MAPLEGROVE_AudreysHouse_1F_Interact_MelissaFather {
    msgbox(format(
        "Feels like just yesterday, I was taking Melissa to her first day of trainer school.\p"
        "Now she's exploring the Maryan wilds all on her own, same as her older brother.\p"
        "Heh... Kids grow up so fast, don't they? Blink and you'll miss it.\p"
        "That's why it's important to cherish every little moment with them.\p"
        "You never know when the next time you'll be able to see them again."
    ), MSGBOX_NPC)
}

script ISLANDGAME_MAPLEGROVE_AudreysHouse_1F_Interact_MelissaMother {
    if (!flag(FLAG_MINTY_MEADOWS_RIVAL_DEFEATED)) {
        msgbox(format(
            "Hello dearie! You must be {PLAYER}, right? My daughter told me about you.\p"
            "She was very excited to get a colleague from beyond the great blue seas!\p"
            "I hope you two get along well. She can be a little ditzy and stubborn at times, but she's a warm and honest young lady.\p"
            "Oh, where is she right now? She should be in the Minty Meadows doing research.\p"
            "I'm sure she'd be more than happy to show you around Oranna."
        ), MSGBOX_NPC)
    }
    else {
        msgbox(format(
            "It's good to see you again, dearie! Melissa just stopped by earlier.\p"
            "She told me all about how you two helped Mr. Fresa find his missing Mareep!\p"
            "You were both very kind and brave to stand up to that wild Mightyena.\p"
            "Thank you for being with my daughter. She gets ahead of herself a lot, so I'm glad neither of you were hurt."
        ), MSGBOX_NPC)
    }
}
