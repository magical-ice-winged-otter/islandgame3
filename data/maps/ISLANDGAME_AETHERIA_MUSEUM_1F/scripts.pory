}

script ISLANDGAME_AETHERIA_MUSEUM_1F_StoneTablet {
    msgbox(format(
        "“Ancient Tablet”\p"
        "“Within the maws of the Great Volcano slumbered the wicked Wings of Chaos.”\p"
        "“A primordial force of unstoppable evil, it once threatened to engulf the world in eternal darkness.”\p"
        "“But from the depths emerged our glorious savior to grant us salvation.”\p"
        "“And so the fiend was sealed whence it came. The world saved from cataclysmic destruction.”"
