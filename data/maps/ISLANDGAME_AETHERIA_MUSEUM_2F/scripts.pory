// states for main quest
const STATE_INITIAL = 0
const STATE_FOUND_RIVAL = 1
const STATE_DEFEATED_RIVAL = 2
const STATE_EXHIBIT_SAW_MELISSA = 3
const STATE_EXHIBIT_BEGIN_EXHIBIT = 4
const STATE_EXHIBIT_WATCHED_MOVIE = 5
// const STATE_FOUND_THIEF = 6
// const STATE_FINAL = 7

mapscripts ISLANDGAME_AETHERIA_MUSEUM_2F_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_AETHERIA_STATE, STATE_EXHIBIT_BEGIN_EXHIBIT {
            call(ISLANDGAME_AETHERIA_MUSEUM_2F_MovieCutscene)
            setvar(VAR_AETHERIA_STATE, STATE_EXHIBIT_WATCHED_MOVIE)
            return
        }
    ]
}


script ISLANDGAME_AETHERIA_MUSEUM_2F_MovieCutscene {
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down * 5, walk_right * 6, face_up))
    waitmovement(0)
    applymovement(AETHERIA_MUSEUM_2F_CURATOR, moves(walk_in_place_down * 2, delay_16 * 2))
    waitmovement(0)
    msgbox(format(
        "Salutations, everyone! Thank you for coming to see our latest and most ambitious addition yet!\p"
        "My name is Solomon. I am the curator of this museum, and today I present to you, a glimpse into Marya's past...\p"
        "Please enjoy... The Darkest Night!"
    ), MSGBOX_AUTOCLOSE)
    applymovement(AETHERIA_MUSEUM_2F_CURATOR, moves(walk_right * 3, face_down))
    waitmovement(0)
    
    // Intro
    fadescreenswapbuffers(FADE_TO_BLACK)
    special(Script_FadeOutMapMusic)
    waitstate
    setweather(WEATHER_RAIN_THUNDERSTORM)
    doweather
    msgbox(format(
        "“Long ago,{PAUSE 30} a great calamity befell upon our isles.”"
    ), MSGBOX_AUTOCLOSE)

    playbgm(MUS_ABNORMAL_WEATHER, TRUE)
    playse(SE_THUNDER)
    waitse

    // wings of chaos emerge
    // call(ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene1)

    // absol attacks farmer
    // call(ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene2)

    // birbs try n attack wings of chaos
    call(ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene3)

    // lugia emerge
    call(ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene4)

    // lugia saves the day
    call(ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene5)

    fadescreenswapbuffers(FADE_TO_BLACK)
    setvar(VAR_0x8000, 9)
    setvar(VAR_0x8001, 7)
    callnative(TeleportCamera) // snap back to reality
    fadescreenswapbuffers(FADE_FROM_BLACK)

    release

}

script ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene1 {
    setvar(VAR_0x8000, 7)
    setvar(VAR_0x8001, 20)
    callnative(TeleportCamera) 
    fadescreenswapbuffers(FADE_FROM_WHITE)
    delay(240)
    playse(SE_M_EARTHQUAKE)
    special(DoSealedChamberShakingEffect_Long)
    waitstate
    special(DoSealedChamberShakingEffect_Short)
    waitstate
    playse(SE_M_EXPLOSION)
    waitse
    delay(60)
    playmoncry(SPECIES_ETERNATUS, CRY_MODE_ENCOUNTER)
    special(DoSealedChamberShakingEffect_Short)
    waitstate
    waitmoncry
    msgbox(format(
        "The Great Volcano erupted in a fit of unbridled rage under a torrential night.\p"
        "From the billowing smoke emerged an abominable beast with wings of blight."
    ), MSGBOX_AUTOCLOSE)
    fadescreenswapbuffers(FADE_TO_BLACK)
    return
}

script ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene2 {
    setvar(VAR_0x8000, 23)
    setvar(VAR_0x8001, 20)
    callnative(TeleportCamera) 
    fadescreenswapbuffers(FADE_FROM_BLACK)

    applymovement(AETHERIA_MUSEUM_2F_RANCHER, moves(walk_right * 6))
    applymovement(AETHERIA_MUSEUM_2F_DACHSBUN, moves(walk_right * 6))
    applymovement(AETHERIA_MUSEUM_2F_ABSOL, moves(walk_in_place_down * 6))
    waitmovement(0)
    applymovement(AETHERIA_MUSEUM_2F_RANCHER, moves(face_up, emote_question_mark))
    applymovement(AETHERIA_MUSEUM_2F_DACHSBUN, moves(face_up))
    delay(40)
    playmoncry(SPECIES_ABSOL_MEGA, CRY_MODE_ENCOUNTER)
    waitmoncry
    applymovement(AETHERIA_MUSEUM_2F_ABSOL, moves(walk_in_place_fast_down * 2, walk_in_place_faster_down * 5))
    waitmovement(0)
    playmoncry(SPECIES_DACHSBUN, CRY_MODE_NORMAL)
    waitmoncry
    playse(SE_PIN)
    applymovement(AETHERIA_MUSEUM_2F_RANCHER, moves(emote_exclamation_mark))
    applymovement(AETHERIA_MUSEUM_2F_ABSOL, moves(jump_2_down, walk_faster_down))
    waitmovement(0)
    playse(SE_M_CUT)
    applymovement(AETHERIA_MUSEUM_2F_RANCHER, moves(lock_facing_direction, walk_fast_down))
    waitse
    playse(SE_PIN)
    applymovement(AETHERIA_MUSEUM_2F_DACHSBUN, moves(face_right, lock_facing_direction, walk_fast_left, emote_exclamation_mark, walk_in_place_right * 2))
    waitse
    delay(60)
    playmoncry(SPECIES_DACHSBUN, CRY_MODE_NORMAL)
    waitmoncry
    applymovement(AETHERIA_MUSEUM_2F_DACHSBUN, moves(walk_fast_right))
    waitmovement(0)
    playse(SE_M_JUMP_KICK)
    applymovement(AETHERIA_MUSEUM_2F_ABSOL, moves(face_left, jump_in_place_right, face_left))
    applymovement(AETHERIA_MUSEUM_2F_DACHSBUN, moves(walk_faster_left * 2))
    waitmovement(0)
    delay(60)

    msgbox(format(
        "The suffocating smog tainted the skies and the pouring rain.\p"
        "Corrupting Pokémon into heartless creatures of savagery and disdain."
    ))
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    return    
}

script ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene3 {
    setvar(VAR_0x8000, 7)
    setvar(VAR_0x8001, 32)
    callnative(TeleportCamera) 
    setflag(FLAG_TEMP_1) // hide lugia
    removeobject(AETHERIA_MUSEUM_2F_LUGIA)
    fadescreenswapbuffers(FADE_FROM_BLACK)

    delay(120)
    playmoncry(SPECIES_ARTICUNO, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(60)
    playmoncry(SPECIES_ZAPDOS, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(60)
    playmoncry(SPECIES_MOLTRES, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(60)

    playse(SE_M_FLY)
    applymovement(AETHERIA_MUSEUM_2F_ARTICUNO, moves(walk_fast_up * 5))
    delay(20)
    playse(SE_M_FLY)
    applymovement(AETHERIA_MUSEUM_2F_ZAPDOS, moves(walk_fast_up * 4))
    delay(20)
    playse(SE_M_FLY)
    applymovement(AETHERIA_MUSEUM_2F_MOLTRES, moves(walk_fast_up * 4))
    waitmovement(0)

    msgbox(format(
        "The Isle Guardians flew from their roosts to face the wicked beast..."
    ))
    closemessage

    special(DoSealedChamberShakingEffect_Short)
    waitstate
    playse(SE_M_ICY_WIND)
    waitse
    playse(SE_ICE_BREAK)
    waitse
    playse(SE_M_THUNDER_WAVE)
    waitse
    playse(SE_M_THUNDERBOLT)
    waitse
    playse(SE_M_THUNDERBOLT2)
    waitse
    playse(SE_M_FLAMETHROWER)
    waitse
    playse(SE_NOT_EFFECTIVE)
    waitse
    delay(60)
    playmoncry(SPECIES_ETERNATUS, CRY_MODE_ENCOUNTER)
    waitmoncry
    playse(SE_M_HYPER_BEAM)
    waitse
    playse(SE_M_HYPER_BEAM2)
    waitse
    special(DoSealedChamberShakingEffect_Short)
    waitstate
    playse(SE_SUPER_EFFECTIVE)
    waitse
    playmoncry(SPECIES_ARTICUNO, CRY_MODE_WEAK)
    waitmoncry
    playmoncry(SPECIES_ZAPDOS, CRY_MODE_WEAK)
    waitmoncry
    playmoncry(SPECIES_MOLTRES, CRY_MODE_WEAK)
    waitmoncry
    playse(SE_M_NIGHTMARE)
    waitse
    delay(60)
    playse(SE_PIN)
    applymovement(AETHERIA_MUSEUM_2F_ELDER, moves(emote_exclamation_mark))

    applymovement(AETHERIA_MUSEUM_2F_ARTICUNO, moves(walk_down * 5))
    delay(20)
    applymovement(AETHERIA_MUSEUM_2F_ZAPDOS, moves(walk_down * 4))
    delay(20)
    applymovement(AETHERIA_MUSEUM_2F_MOLTRES, moves(walk_down * 4))
    waitmovement(0)
    
    removeobject(AETHERIA_MUSEUM_2F_ARTICUNO)
    removeobject(AETHERIA_MUSEUM_2F_ZAPDOS)
    removeobject(AETHERIA_MUSEUM_2F_MOLTRES)
    // setobjectxyperm(7, 31, AETHERIA_MUSEUM_2F_ARTICUNO)
    // setobjectxyperm(9, 32, AETHERIA_MUSEUM_2F_ZAPDOS)
    // setobjectxyperm(5, 32, AETHERIA_MUSEUM_2F_MOLTRES)
    setobjectmovementtype(AETHERIA_MUSEUM_2F_ARTICUNO, MOVEMENT_TYPE_WALK_IN_PLACE_DOWN)
    setobjectmovementtype(AETHERIA_MUSEUM_2F_ZAPDOS, MOVEMENT_TYPE_WALK_IN_PLACE_DOWN)
    setobjectmovementtype(AETHERIA_MUSEUM_2F_MOLTRES, MOVEMENT_TYPE_WALK_IN_PLACE_DOWN)
    addobject(AETHERIA_MUSEUM_2F_ARTICUNO)
    addobject(AETHERIA_MUSEUM_2F_ZAPDOS)
    addobject(AETHERIA_MUSEUM_2F_MOLTRES)
    release

    applymovement(AETHERIA_MUSEUM_2F_MAN_CUTSCENE, moves(lock_facing_direction, walk_down))
    applymovement(AETHERIA_MUSEUM_2F_EXPERT, moves(lock_facing_direction, walk_down))
    applymovement(AETHERIA_MUSEUM_2F_ELDER, moves(walk_in_place_fast_up * 2, delay_16 * 2, lock_facing_direction, walk_down))
    waitmovement(0)
    waitmovement(0)

    delay(60)

    msgbox(format(
        "But even they stood no chance to the beast's unfathomable power.\p"
        "And our ancestors could only watch, {PAUSE 30}as their protectors betrayed them during their darkest hour.\p"
        "“Someone... anyone... please heed our plea!”\p"
        "“Exorcise this foul creature, I pray to thee!”"
    ))
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    return    
}

script ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene4 {
    setvar(VAR_0x8000, 23)
    setvar(VAR_0x8001, 32)
    callnative(TeleportCamera) 
    fadescreenswapbuffers(FADE_FROM_BLACK)
    special(Script_FadeOutMapMusic)
    waitstate

    delay(120)
    playmoncry(SPECIES_LUGIA, CRY_MODE_ENCOUNTER)
    waitmoncry
    fadescreenswapbuffers(FADE_FROM_WHITE)
    setfieldeffectargument(0, 1)
    dofieldeffect(FLDEFF_NPCFLY_OUT)
    waitfieldeffect(FLDEFF_NPCFLY_OUT)
    delay(120)

    msgbox(format(
        "Then suddenly, from the deepest, darkest depths of the sea...\p"
        "...arose an ethereal dragon with wings of glimmering silver majesty."
    ))
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    return    
}

script ISLANDGAME_AETHERIA_MUSEUM_2F_MovieScene5 {
    setvar(VAR_0x8000, 7)
    setvar(VAR_0x8001, 32)
    callnative(TeleportCamera) 
    fadescreenswapbuffers(FADE_FROM_BLACK)
    
    delay(120)

    setfieldeffectargument(0, 1)
    dofieldeffect(FLDEFF_NPCFLY_OUT)
    fadescreenswapbuffers(FADE_TO_WHITE)
    waitfieldeffect(FLDEFF_NPCFLY_OUT)
    applymovement(AETHERIA_MUSEUM_2F_ARTICUNO, moves(lock_facing_direction, walk_fast_up))
    applymovement(AETHERIA_MUSEUM_2F_ZAPDOS, moves(lock_facing_direction, walk_fast_up))
    applymovement(AETHERIA_MUSEUM_2F_MOLTRES, moves(lock_facing_direction, walk_fast_up))
    waitmovement(0)
    clearflag(FLAG_TEMP_1)
    addobject(AETHERIA_MUSEUM_2F_LUGIA)
    release
    fadescreenswapbuffers(FADE_FROM_WHITE)

    
    delay(60)

    playse(SE_PIN)
    applymovement(AETHERIA_MUSEUM_2F_ELDER, moves(emote_exclamation_mark))
    applymovement(AETHERIA_MUSEUM_2F_MAN_CUTSCENE, moves(emote_exclamation_mark))
    applymovement(AETHERIA_MUSEUM_2F_EXPERT, moves(emote_exclamation_mark))
    delay(60)
    
    playbgm(MUS_BW_VS_WINNING, TRUE)
    playmoncry(SPECIES_LUGIA, CRY_MODE_ENCOUNTER)
    special(DoSealedChamberShakingEffect_Short)
    waitstate
    waitmoncry
    fadescreenswapbuffers(FADE_TO_WHITE)

    removeobject(AETHERIA_MUSEUM_2F_ARTICUNO)
    removeobject(AETHERIA_MUSEUM_2F_ZAPDOS)
    removeobject(AETHERIA_MUSEUM_2F_MOLTRES)
    setobjectxyperm(AETHERIA_MUSEUM_2F_ARTICUNO, 7, 33)
    setobjectxyperm(AETHERIA_MUSEUM_2F_ZAPDOS, 5, 32)
    setobjectxyperm(AETHERIA_MUSEUM_2F_MOLTRES, 9, 32)
    setobjectmovementtype(AETHERIA_MUSEUM_2F_ARTICUNO, MOVEMENT_TYPE_WALK_IN_PLACE_UP)
    setobjectmovementtype(AETHERIA_MUSEUM_2F_ZAPDOS, MOVEMENT_TYPE_WALK_IN_PLACE_UP)
    setobjectmovementtype(AETHERIA_MUSEUM_2F_MOLTRES, MOVEMENT_TYPE_WALK_IN_PLACE_UP)
    addobject(AETHERIA_MUSEUM_2F_ARTICUNO)
    addobject(AETHERIA_MUSEUM_2F_ZAPDOS)
    addobject(AETHERIA_MUSEUM_2F_MOLTRES)

    fadescreenswapbuffers(FADE_FROM_WHITE)

    delay(120)

    msgbox(format(
        "With a deafening roar and a powerful wingbeat...\p"
        "...the dragon summoned a tempest that caused the virulent corruption to retreat!"
    ))
    closemessage

    playmoncry(SPECIES_LUGIA, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(60)
    playse(SE_M_FLY)
    applymovement(AETHERIA_MUSEUM_2F_LUGIA, moves(walk_up * 6))
    delay(30)
    playse(SE_M_FLY)
    applymovement(AETHERIA_MUSEUM_2F_ARTICUNO, moves(walk_up * 7))
    applymovement(AETHERIA_MUSEUM_2F_ZAPDOS, moves(walk_up * 7))
    applymovement(AETHERIA_MUSEUM_2F_MOLTRES, moves(walk_up * 7))
    waitmovement(0)
    playse(SE_M_ICY_WIND)
    waitse
    playse(SE_M_THUNDER_WAVE)
    waitse
    playse(SE_M_FLAME_WHEEL2)
    waitse
    playse(SE_M_STRING_SHOT)
    waitse
    special(DoSealedChamberShakingEffect_Short)
    waitstate
    playse(SE_SUPER_EFFECTIVE)
    waitse
    playmoncry(SPECIES_ETERNATUS, CRY_MODE_WEAK)
    waitmoncry
    playse(SE_M_SELF_DESTRUCT)
    special(DoSealedChamberShakingEffect_Long)
    waitstate
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    setweather(WEATHER_NONE)
    doweather
    special(WaitWeather)
    waitstate

    msgbox(format(
        ""
    ))
    fadescreenswapbuffers(FADE_TO_BLACK)
    return    

}