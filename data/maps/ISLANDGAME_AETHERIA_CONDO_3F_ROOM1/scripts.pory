mapscripts ISLANDGAME_AETHERIA_CONDO_3F_ROOM1_MapScripts {}


script ISLANDGAME_AETHERIA_CONDO_3F_ROOM1_Woman {
    lock
    faceplayer
    if(flag(FLAG_AETHERIA_ROOM_SERVICE)) {
        msgbox(format(
            "I try not to order room service too often, but it's okay to treat yourself every once in a while.\p"
            "¥2500 for a hamburger is highway robbery though."
        ), MSGBOX_AUTOCLOSE)
    }
    else {
        msgbox(format(
            "Oh bother, we ordered some room service, but it seems like they mixed up our order.\p"
            "I'd hate for such gourmet food to go to waste. Would you like it instead?"
        ), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            giveitem(ITEM_ROOM_SERVICE)
            setflag(FLAG_AETHERIA_ROOM_SERVICE)
        }
    }
}