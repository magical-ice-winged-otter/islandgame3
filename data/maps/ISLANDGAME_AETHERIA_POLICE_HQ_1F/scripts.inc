ISLANDGAME_AETHERIA_POLICE_HQ_1F_FrontDeskWoman_Text_0:
# 8 "data/maps/ISLANDGAME_AETHERIA_POLICE_HQ_1F/scripts.pory"
	.string "Welcome to the Maryan Police\n"
	.string "Department.\p"
	.string "We're currently experiencing a large\n"
	.string "volume of calls, so please leave me\l"
	.string "alone.$"

ISLANDGAME_AETHERIA_POLICE_HQ_1F_FrontDeskMan_Text_0:
# 17 "data/maps/ISLANDGAME_AETHERIA_POLICE_HQ_1F/scripts.pory"
	.string "I joined the force in hopes of one day\n"
	.string "being able to join the International\l"
	.string "Police so I could go around the world.\p"
	.string "But I've been stuck here for years\n"
	.string "doing lame busy work...$"

ISLANDGAME_AETHERIA_POLICE_HQ_1F_NoEntry_Text_0:
# 26 "data/maps/ISLANDGAME_AETHERIA_POLICE_HQ_1F/scripts.pory"
