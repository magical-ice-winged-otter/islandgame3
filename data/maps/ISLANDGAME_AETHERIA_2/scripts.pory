const FLAG_DAYTIME = FLAG_TEMP_2
const FLAG_NIGHTTIME = FLAG_TEMP_3

mapscripts ISLANDGAME_AETHERIA_2_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        gettime

        if (var(VAR_0x8000) < 6 || var(VAR_0x8000) >= 18) {
            setflag(FLAG_NIGHTTIME) // hides daytime npcs
            setflag(FLAG_TEMP_5) // (TEMP) cameo battle(s) only occur during daytime
        }
        else {
            setflag(FLAG_DAYTIME) // hides nighttime npcs
        }

        if(!flag(FLAG_DAILY_AETHERIA_CAMEO_BATTLE)) { // hide npcs if there is a cameo active
            setflag(FLAG_TEMP_4)
        }
        else {
            setflag(FLAG_TEMP_5)
        }
    }
}

// Important NPCs
script ISLANDGAME_AETHERIA_IceCreamLady {
    lock
    faceplayer
    showmoneybox(18, 1)
    msgbox(format(
        "Helloooooo! Would you like some frosty Nice Cream? It's only ¥500 for a cone!"
    ), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        checkmoney(500)
        if(var(VAR_RESULT)) {
            removemoney(500)
            updatemoneybox
            playse(SE_SHOP)
            waitse
            playse(SE_VEND)
            waitse
            hidemoneybox
            msgbox(format(
                "Enjoy!"
            ))
            giveitem(ITEM_CASTELIACONE)
        }
        else {
            msgbox(format(
                "Oh... you don't have enough money."
            ))
        }
    }
    hidemoneybox
    closemessage
    release
}






// Signs
script ISLANDGAME_AETHERIA_PoliceHQ {
    msgbox(format(
        "MARYAN POLICE HEADQUARTERS"
    ), MSGBOX_SIGN)
}


// Trainers 
script ISLANDGAME_AETHERIA_ParkOfficer {
    trainerbattle_single(TRAINER_AETHERIA_PARK_OFFICER,
        format(
            "Aha! I've finally caught you!"
        ),
        format(
            "Oh...{PAUSE 30} You're not the one."
        ))
    msgbox(format(
        "Sorry about the mix-up. It gets real dark around here at night.\p"
        "I've been on the lookout for a man in a business suit for weeks...\p"
        "If you see him, please let me know."
    ), MSGBOX_AUTOCLOSE)
}

script ISLANDGAME_AETHERIA_PoliceDeptOffDutyOfficer {
    trainerbattle_single(TRAINER_AETHERIA_DEPT_OFFICER,
        format(
            "I may be off-duty, but that doesn't mean I can't pull you over for a battle!"
        ),
        format(
            "Heh, stay safe out there!"
        ))
    msgbox(format(
        "Even if I'm off-duty, I'm still here to serve and protect the great people of Marya."
    ), MSGBOX_AUTOCLOSE)
}



